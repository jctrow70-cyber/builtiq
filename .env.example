# Use TEST Supabase keys in .env.local and Vercel builtiq-test.
# Use LIVE Supabase keys in Vercel builtiq (main branch) only.
# See docs/ENVIRONMENTS.md
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Service role — catalog import + bug report admin API (never expose in client code)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Comma-separated platform admin emails (Settings admin tools + bug report inbox)
BUILDIQ_ADMIN_EMAILS=you@example.com
# Legacy alias still supported:
# BUILDIQ_CATALOG_ADMIN_EMAILS=you@example.com
# Resend — email alerts when users submit bug reports (server only)
RESEND_API_KEY=your_resend_api_key
# Verified sender in Resend, e.g. BuildIQ Health <bugs@yourdomain.com>
BUILDIQ_EMAIL_FROM=BuildIQ Health <onboarding@resend.dev>
# Optional: override who receives bug report emails (defaults to BUILDIQ_ADMIN_EMAILS)
# BUILDIQ_BUG_REPORT_NOTIFY_EMAILS=you@example.com,teammate@example.com
# OpenAI — server-side AI program generation only (never expose in client code)
OPENAI_API_KEY=your_openai_api_key
# Program generation uses Responses API + low reasoning (BIQ-0228).
# OPENAI_PROGRAM_MODEL=gpt-5.4
# OPENAI_PROGRAM_REASONING_EFFORT=low
# OPENAI_PROGRAM_TIMEOUT_MS=75000

# --- MOB-01 Capacitor (development only; never commit secrets) ---
# Preview / test deployment URL for the Capacitor WebView bridge.
# Must use Vercel Preview env vars → development Supabase.
# Do NOT set this to https://builtiq-duf7.vercel.app (production).
# Alternative: copy mobile/dev-target.example.json → mobile/dev-target.json
# BUILDIQ_MOBILE_SERVER_URL=https://your-preview.vercel.app
# Future local-asset builds (not MOB-01): absolute API origin for /api calls
# NEXT_PUBLIC_BUILDIQ_API_BASE_URL=https://your-preview.vercel.app
# NEXT_PUBLIC_BUILDIQ_MOBILE_BRIDGE=1
